# Copy this to .env and fill in your values

# Database (Railway provides these automatically as ${{MySQL.*}} variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=movie_booking

# Frontend URL for CORS (your Vercel URL after deploy)
FRONTEND_URL=https://your-app.vercel.app

# Server port
PORT=3000
