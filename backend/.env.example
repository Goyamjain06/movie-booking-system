# Copy to .env and fill in your values (never commit .env)

# --- Database (MySQL 8 / MariaDB 10.5+) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=movie_booking
# Managed MySQL (Aiven, TiDB Cloud, Railway public proxy...) usually needs TLS:
# DB_SSL=true

# --- Server ---
PORT=3000
# Your frontend URL(s) for CORS, comma separated (set after deploying the frontend)
FRONTEND_URL=http://localhost:3001

# --- Auth ---
# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- AI chatbot (optional) ---
# Without a key Cinebot still works in built-in mode (rule-based, answers from the live database).
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5

# --- Demo behaviour ---
# Mark some seats of generated shows as already sold so seat maps look alive.
SIMULATE_OCCUPANCY=true
